@model MotorcycleShopMVC.Models.Order
@{
    ViewData["Title"] = $"Chi tiết đơn #{Model.OrderId}";
}

<div class="container mt-4">
    <h2 class="mb-3">Chi tiết đơn hàng #@Model.OrderId</h2>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="border rounded p-3">
                <h6>Thông tin giao hàng</h6>
                <p><strong>Địa chỉ:</strong> @Model.ShippingAddress</p>
                <p><strong>Ngày đặt:</strong> @Model.OrderDate?.ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>Tổng tiền:</strong> <span class="text-danger fw-bold">@Model.TotalAmount.ToString("N0") đ</span></p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="border rounded p-3">
                <h6>Thanh toán</h6>
                <p><strong>Phương thức:</strong> @Model.PaymentMethod</p>
                <p><strong>Trạng thái:</strong> @Model.PaymentStatus</p>
            </div>
        </div>
    </div>

    <h5 class="mb-3">Sản phẩm trong đơn</h5>

    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-light text-center">
                <tr>
                    <th>Sản phẩm</th>
                    <th>Loại</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thêm lại vào giỏ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderItems)
                {
                    var name = item.Motorcycle?.ModelName ?? item.Part?.PartName ?? "Sản phẩm";
                    var price = item.Price;

                    <tr>
                        <td>@name</td>
                        <td>@(item.MotorcycleId != null ? "Motorcycle" : "Part")</td>
                        <td class="text-danger fw-bold">@price.ToString("N0") đ</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-center">
                            @if (item.MotorcycleId != null)
                            {
                                <form asp-controller="Cart" asp-action="AddMotorcycle" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="motorcycleId" value="@item.MotorcycleId" />
                                    <input type="hidden" name="quantity" value="@item.Quantity" />
                                    <button type="submit" class="btn btn-sm btn-outline-success">Thêm lại</button>
                                </form>
                            }
                            else if (item.PartId != null)
                            {
                                <form asp-controller="Cart" asp-action="AddPart" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="partId" value="@item.PartId" />
                                    <input type="hidden" name="quantity" value="@item.Quantity" />
                                    <button type="submit" class="btn btn-sm btn-outline-success">Thêm lại</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <a asp-action="History" class="btn btn-secondary mt-3">Quay lại</a>
</div>