@model MotorcycleShopMVC.Models.ViewModels.AdminDashboardViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4">

    <!-- USERS -->
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <h6 class="text-muted mb-2">
                            Total Users
                        </h6>

                        <h2 class="fw-bold mb-0">
                            @Model.TotalUsers
                        </h2>
                    </div>

                    <div class="fs-1">
                        👥
                    </div>

                </div>

            </div>
        </div>
    </div>

    <!-- MOTORCYCLES -->
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <h6 class="text-muted mb-2">
                            Total Motorcycles
                        </h6>

                        <h2 class="fw-bold mb-0">
                            @Model.TotalMotorcycles
                        </h2>
                    </div>

                    <div class="fs-1">
                        🏍
                    </div>

                </div>

            </div>
        </div>
    </div>

    <!-- ORDERS -->
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <h6 class="text-muted mb-2">
                            Total Orders
                        </h6>

                        <h2 class="fw-bold mb-0">
                            @Model.TotalOrders
                        </h2>
                    </div>

                    <div class="fs-1">
                        📦
                    </div>

                </div>

            </div>
        </div>
    </div>

    <!-- REVENUE -->
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <h6 class="text-muted mb-2">
                            Total Revenue
                        </h6>

                        <h4 class="fw-bold mb-0 text-success">
                            @String.Format("{0:N0} VNĐ", Model.TotalRevenue)
                        </h4>
                    </div>

                    <div class="fs-1">
                        💰
                    </div>

                </div>

            </div>
        </div>
    </div>

</div>

<!-- QUICK ACTIONS -->

<div class="card shadow-sm border-0 mt-5">

    <div class="card-body">

        <h4 class="fw-bold mb-4">
            Quick Actions
        </h4>

        <div class="row g-3">

            <div class="col-md-4">
                <a asp-action="Users"
                       class="btn btn-primary w-100 py-3">
                    👥 Manage Users
                </a>
            </div>

            <div class="col-md-4">
                <a asp-action="Orders"
                       class="btn btn-warning w-100 py-3">
                    📦 Manage Orders
                </a>
            </div>

            <div class="col-md-4">
                <a asp-action="Revenue"
                       class="btn btn-success w-100 py-3">
                    📈 Revenue Analytics
                </a>
            </div>

        </div>

    </div>

</div>

<!-- WELCOME PANEL -->

<div class="card shadow-sm border-0 mt-4">

    <div class="card-body">

        <h4 class="fw-bold">
            Welcome Administrator
        </h4>

        <p class="text-muted mb-0">
            Use the dashboard to manage users, orders and monitor store revenue.
        </p>

    </div>

</div>