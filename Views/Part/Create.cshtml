@model MotorcycleShopMVC.Models.Part

@{
    ViewData["Title"] = "Create Part";
}

<div class="container mt-4">

    <div class="card shadow border-0">

        <div class="card-header bg-dark text-white">
            <h3 class="mb-0">
                🔧 Create New Part
            </h3>
        </div>

        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="row">

                    <!-- LEFT COLUMN -->

                    <div class="col-md-6">

                        <div class="mb-3">
                            <label asp-for="PartName"
                                   class="form-label fw-bold">
                                Part Name
                            </label>

                            <input asp-for="PartName"
                                   class="form-control" />

                            <span asp-validation-for="PartName"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CategoryId"
                                   class="form-label fw-bold">
                                Category
                            </label>

                            <select asp-for="CategoryId"
                                    asp-items="ViewBag.CategoryId"
                                    class="form-select">
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BrandId"
                                   class="form-label fw-bold">
                                Brand
                            </label>

                            <select asp-for="BrandId"
                                    asp-items="ViewBag.BrandId"
                                    class="form-select">
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Price"
                                   class="form-label fw-bold">
                            </label>

                            <input asp-for="Price"
                                   class="form-control" />

                            <span asp-validation-for="Price"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="StockQuantity"
                                   class="form-label fw-bold">
                            </label>

                            <input asp-for="StockQuantity"
                                   class="form-control" />

                            <span asp-validation-for="StockQuantity"
                                  class="text-danger">
                            </span>
                        </div>

                    </div>

                    <!-- RIGHT COLUMN -->

                    <div class="col-md-6">

                        <div class="mb-3">
                            <label asp-for="WarrantyMonths"
                                   class="form-label fw-bold">
                            </label>

                            <input asp-for="WarrantyMonths"
                                   class="form-control" />

                            <span asp-validation-for="WarrantyMonths"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">

                            <label asp-for="ImagePath"
                                   class="form-label fw-bold">
                                Image URL
                            </label>

                            <input asp-for="ImagePath"
                                   id="imageInput"
                                   class="form-control"
                                   placeholder="/images/parts/brake-pad.jpg" />

                            <span asp-validation-for="ImagePath"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- IMAGE PREVIEW -->

                        <div class="mb-3 text-center">

                            <img id="previewImage"
                                 src="https://via.placeholder.com/300x200?text=Part+Image"
                                 class="img-fluid rounded border shadow-sm"
                                 style="max-height:250px;" />

                        </div>

                    </div>

                </div>

                <!-- DESCRIPTION -->

                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label fw-bold">
                    </label>

                    <textarea asp-for="Description"
                              rows="5"
                                  class="form-control">
                    </textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- BUTTONS -->

                    <div class="d-flex justify-content-between">

                        <a asp-action="Index"
                               class="btn btn-outline-secondary">
                            ← Back To List
                        </a>

                        <button type="submit"
                                class="btn btn-success px-4">
                            ✅ Create Part
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

    @section Scripts {

        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }

        <script>

            const imageInput =
                document.getElementById("imageInput");

            const previewImage =
                document.getElementById("previewImage");

            imageInput.addEventListener("input", function () {

                if (this.value.trim() !== "") {

                    previewImage.src = this.value;

                }

            });

        </script>

    }