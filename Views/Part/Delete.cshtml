@model MotorcycleShopMVC.Models.Part

@{
    ViewData["Title"] = "Delete Part";
}

<div class="container mt-4">

    <div class="card border-danger shadow">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">
                ⚠ Delete Part
            </h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">

                <strong>Warning!</strong>

                This action cannot be undone.

                Are you sure you want to permanently delete this part?

            </div>

            <div class="row">

                <!-- IMAGE -->
                <div class="col-md-4 text-center mb-4">

                    <img src="@Url.Content("~/" + Model.ImagePath)"
                         class="img-fluid rounded shadow border"
                         style="max-height:300px; object-fit:cover;" />

                </div>

                <!-- INFO -->
                <div class="col-md-8">

                    <table class="table table-striped align-middle">

                        <tbody>

                            <tr>
                                <th style="width:220px;">Part Name</th>
                                <td>@Model.PartName</td>
                            </tr>

                            <tr>
                                <th>Price</th>
                                <td class="text-danger fw-bold">
                                    @Model.Price.ToString("N0") VNĐ
                                </td>
                            </tr>

                            <tr>
                                <th>Stock Quantity</th>
                                <td>@Model.StockQuantity</td>
                            </tr>

                            <tr>
                                <th>Warranty</th>
                                <td>@Model.WarrantyMonths months</td>
                            </tr>

                            <tr>
                                <th>Brand</th>
                                <td>@Model.Brand?.BrandName</td>
                            </tr>

                            <tr>
                                <th>Category</th>
                                <td>@Model.Category?.CategoryName</td>
                            </tr>

                            <tr>
                                <th>Description</th>
                                <td>@Model.Description</td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

            <hr />

            <form asp-action="Delete">

                <input type="hidden"
                       asp-for="PartId" />

                <div class="d-flex justify-content-between">

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        ← Back To List
                    </a>

                    <button type="submit"
                            class="btn btn-danger">
                        🗑 Delete Permanently
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
