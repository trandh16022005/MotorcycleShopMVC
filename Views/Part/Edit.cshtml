@model MotorcycleShopMVC.Models.Part

@{
    ViewData["Title"] = "Edit Part";
}

<div class="container mt-4">

    <div class="card shadow border-0">

        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                🔧 Edit Part
            </h3>
        </div>

        <div class="card-body">

            <form asp-action="Edit">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <input type="hidden"
                       asp-for="PartId" />

                <div class="row">

                    <!-- IMAGE -->
                    <div class="col-lg-4 mb-4">

                        <div class="text-center">

                            <img src="@Url.Content("~/" + Model.ImagePath)"
                                 class="img-fluid rounded shadow-sm border"
                                 style="max-height:300px; object-fit:cover;" />

                            <div class="mt-3">

                                <label asp-for="ImagePath"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="ImagePath"
                                       class="form-control" />

                                <span asp-validation-for="ImagePath"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>

                    <!-- FORM -->
                    <div class="col-lg-8">

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="PartName"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="PartName"
                                       class="form-control" />

                                <span asp-validation-for="PartName"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="Price"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Price"
                                       class="form-control" />

                                <span asp-validation-for="Price"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="CategoryId"
                                       class="form-label fw-semibold">
                                </label>

                                <select asp-for="CategoryId"
                                        asp-items="ViewBag.CategoryId"
                                        class="form-select">
                                </select>

                                <span asp-validation-for="CategoryId"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="BrandId"
                                       class="form-label fw-semibold">
                                </label>

                                <select asp-for="BrandId"
                                        asp-items="ViewBag.BrandId"
                                        class="form-select">
                                </select>

                                <span asp-validation-for="BrandId"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="StockQuantity"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="StockQuantity"
                                       class="form-control" />

                                <span asp-validation-for="StockQuantity"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="WarrantyMonths"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="WarrantyMonths"
                                       class="form-control" />

                                <span asp-validation-for="WarrantyMonths"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-12 mb-3">

                                <label asp-for="Description"
                                       class="form-label fw-semibold">
                                </label>

                                <textarea asp-for="Description"
                                          rows="5"
                                          class="form-control">
                            </textarea>

                                <span asp-validation-for="Description"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

                <hr />

                <div class="d-flex justify-content-between">

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        ← Back To List
                    </a>

                    <button type="submit"
                            class="btn btn-success">
                        💾 Save Changes
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
