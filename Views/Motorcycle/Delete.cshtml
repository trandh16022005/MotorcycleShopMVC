@model MotorcycleShopMVC.Models.Motorcycle

@{
    ViewData["Title"] = "Delete Motorcycle";
}

<div class="container mt-5">

    <div class="card shadow border-0">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">
                ⚠ Confirm Delete Motorcycle
            </h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                <strong>Warning!</strong>
                This action cannot be undone.
            </div>

            <div class="row">

                <!-- IMAGE -->
                <div class="col-md-4 text-center">

                    <img src="@Url.Content("~/" + Model.ImagePath)"
                         class="img-fluid rounded shadow-sm"
                         style="max-height:300px; object-fit:cover;" />

                </div>

                <!-- INFO -->
                <div class="col-md-8">

                    <h2 class="fw-bold mb-3">
                        @Model.ModelName
                    </h2>

                    <table class="table table-bordered">

                        <tr>
                            <th width="35%">Brand</th>
                            <td>@Model.Brand?.BrandName</td>
                        </tr>

                        <tr>
                            <th>Vehicle Type</th>
                            <td>@Model.Type?.TypeName</td>
                        </tr>

                        <tr>
                            <th>Engine Capacity</th>
                            <td>@Model.EngineCapacity cc</td>
                        </tr>

                        <tr>
                            <th>Production Year</th>
                            <td>@Model.YearFrom - @Model.YearTo</td>
                        </tr>

                        <tr>
                            <th>Color</th>
                            <td>@Model.Color</td>
                        </tr>

                        <tr>
                            <th>Stock</th>
                            <td>@Model.StockQty</td>
                        </tr>

                        <tr>
                            <th>Price</th>
                            <td class="text-danger fw-bold">
                                @Model.Price.ToString("N0") VNĐ
                            </td>
                        </tr>

                    </table>

                </div>

            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <hr />

                <h5>Description</h5>

                <p class="text-muted">
                    @Model.Description
                </p>
            }

        </div>

        <div class="card-footer d-flex justify-content-between">

            <a asp-action="Index"
               class="btn btn-secondary">
                ← Cancel
            </a>

            <form asp-action="Delete">

                <input type="hidden"
                       asp-for="MotorcycleId" />

                <button type="submit"
                        class="btn btn-danger">
                    🗑 Delete Motorcycle
                </button>

            </form>

        </div>

    </div>

</div>