@model PaginatedList<MotorcycleShopMVC.Models.Motorcycle>

@{
    ViewData["Title"] = "Motorcycle Library";
}

<div class="container mt-4">

    <!-- 🔥 HERO -->
    <div class="p-4 mb-4 text-white rounded" style="background: linear-gradient(135deg,#1a1a1a,#343a40)">
        <h1 class="fw-bold">Motorcycle Library</h1>
        <p>Discover your perfect ride</p>
        <span class="badge bg-light text-dark">
            Tổng: @Model.TotalItemCount xe
        </span>
    </div>

    <!-- 🔍 FILTER -->
    <form asp-action="Index" method="get" class="bg-light p-3 rounded shadow-sm mb-4">
        <div class="row g-2">

            <div class="col-md-3">
                <input type="text" name="searchString"
                       value="@ViewData["CurrentFilter"]"
                       class="form-control"
                       placeholder="Tìm xe..." />
            </div>

            <div class="col-md-2">
                <select name="brandId" asp-items="@(ViewData["BrandId"] as SelectList)" class="form-select">
                    <option value="">Hãng</option>
                </select>
            </div>

            <div class="col-md-2">
                <select name="typeId" asp-items="@(ViewData["TypeId"] as SelectList)" class="form-select">
                    <option value="">Loại</option>
                </select>
            </div>

            <div class="col-md-2">
                <select name="priceRange" asp-items="@(ViewData["PriceRanges"] as SelectList)" class="form-select">
                    <option value="">Giá</option>
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button class="btn btn-primary w-100">Tìm</button>
                <a asp-action="Index" class="btn btn-secondary w-100">Reset</a>
            </div>

        </div>
    </form>

    <!-- 🚗 GRID -->
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">

                    <img src="@Url.Content("~/" + item.ImagePath)"
                         class="card-img-top"
                         style="height:200px; object-fit:cover;" />

                    <div class="card-body d-flex flex-column">

                        <h5 class="fw-bold">@item.ModelName</h5>

                        <p class="text-muted mb-1">
                            @item.Brand?.BrandName
                        </p>

                        <small>
                            Engine: @item.EngineCapacity cc <br />
                            Stock: @item.StockQty
                        </small>

                        <h5 class="text-danger mt-2">
                            @item.Price.ToString("N0") VNĐ
                        </h5>

                        <div class="mt-auto d-grid gap-2">

                            <a asp-action="Details"
                                   asp-route-id="@item.MotorcycleId"
                                   class="btn btn-primary">
                                Xem chi tiết
                            </a>

                            <form asp-controller="Cart" asp-action="AddMotorcycle" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="motorcycleId" value="@item.MotorcycleId" />
                                <input type="hidden" name="quantity" value="1" />
                                <button class="btn btn-success">
                                    🛒 Thêm vào giỏ
                                </button>
                            </form>

                        </div>

                    </div>
                </div>
            </div>
        }
    </div>

    <!-- 📄 PAGINATION -->
    @{
        var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
        var nextDisabled = !Model.HasNextPage ? "disabled" : "";

        var routeData = new Dictionary<string, string>
        {
            { "searchString", ViewData["CurrentFilter"]?.ToString() },
            { "brandId", ViewData["CurrentBrandId"]?.ToString() },
            { "typeId", ViewData["CurrentTypeId"]?.ToString() },
            { "priceRange", ViewData["CurrentPriceRange"]?.ToString() }
        };
    }

    <div class="d-flex justify-content-center mt-4">
        <ul class="pagination">

            <li class="page-item @prevDisabled">
                <a class="page-link"
                       asp-action="Index"
                       asp-all-route-data="@routeData"
                       asp-route-pageNumber="@(Model.PageIndex - 1)">
                    Trước
                </a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link"
                           asp-action="Index"
                           asp-all-route-data="@routeData"
                           asp-route-pageNumber="@i">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @nextDisabled">
                <a class="page-link"
                       asp-action="Index"
                       asp-all-route-data="@routeData"
                       asp-route-pageNumber="@(Model.PageIndex + 1)">
                    Sau
                </a>
            </li>

        </ul>
    </div>

</div>