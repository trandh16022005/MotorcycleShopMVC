@model PaginatedList<MotorcycleShopMVC.Models.Motorcycle>

@{
    ViewData["Title"] = "Danh sách xe";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Thêm xe mới</a>
</p>

<!-- FILTER -->
<form asp-action="Index" method="get">
    <div class="row mb-3">
        <div class="col-md-3">
            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]"
                   class="form-control" placeholder="Tìm theo tên xe..." />
        </div>

        <div class="col-md-2">
            <select name="brandId" asp-items="@(ViewData["BrandId"] as SelectList)" class="form-control">
                <option value="">Tất cả hãng</option>
            </select>
        </div>

        <div class="col-md-2">
            <select name="typeId" asp-items="@(ViewData["TypeId"] as SelectList)" class="form-control">
                <option value="">Tất cả loại</option>
            </select>
        </div>

        <div class="col-md-2">
            <select name="yearFrom" asp-items="@(ViewData["YearFrom"] as SelectList)" class="form-control">
                <option value="">Tất cả năm</option>
            </select>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-3">
            <select name="priceRange" asp-items="@(ViewData["PriceRanges"] as SelectList)" class="form-control">
                <option value="">Tất cả giá</option>
            </select>
        </div>

        <div class="col-md-3">
            <select name="engineRange" asp-items="@(ViewData["EngineRanges"] as SelectList)" class="form-control">
                <option value="">Tất cả dung tích</option>
            </select>
        </div>

        <div class="col-md-3">
            <button type="submit" class="btn btn-primary">Tìm</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Reset</a>
        </div>
    </div>
</form>

<!-- TABLE -->
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Hình</th>
            <th>Tên xe</th>
            <th>Hãng</th>
            <th>Loại</th>
            <th>Giá</th>
            <th>Năm</th>
            <th>Tồn kho</th>
            <th class="text-center">Hành động</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="text-center">
                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="@Url.Content("~/" + item.ImagePath)"
                             alt="@item.ModelName"
                             style="width:100px; height:auto; object-fit:cover;" />
                    }
                </td>

                <td>@item.ModelName</td>
                <td>@item.Brand?.BrandName</td>
                <td>@item.Type?.TypeName</td>
                <td>@item.Price.ToString("N0") VNĐ</td>
                <td>@item.YearFrom</td>
                <td>@item.StockQty</td>

                <td class="text-center" style="min-width:180px;">
                    <a asp-action="Edit" asp-route-id="@item.MotorcycleId"
                       class="btn btn-sm btn-info">Sửa</a>

                    <a asp-action="Details" asp-route-id="@item.MotorcycleId"
                       class="btn btn-sm btn-secondary">Chi tiết</a>

                    <a asp-action="Delete" asp-route-id="@item.MotorcycleId"
                       class="btn btn-sm btn-danger">Xóa</a>

                    <!-- AJAX ADD TO CART -->
                    <button type="button"
                            class="btn btn-sm btn-success add-to-cart-btn mt-1"
                            data-id="@item.MotorcycleId">
                        🛒 Thêm
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- PAGINATION -->
@{
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";

    var routeData = new Dictionary<string, string>
    {
        { "searchString", ViewData["CurrentFilter"]?.ToString() },
        { "brandId", ViewData["CurrentBrandId"]?.ToString() },
        { "typeId", ViewData["CurrentTypeId"]?.ToString() },
        { "yearFrom", ViewData["CurrentYearFrom"]?.ToString() },
        { "priceRange", ViewData["CurrentPriceRange"]?.ToString() },
        { "engineRange", ViewData["CurrentEngineRange"]?.ToString() }
    };
}

<div class="d-flex justify-content-center">
    <ul class="pagination">
        <li class="page-item @prevDisabled">
            <a class="page-link"
                   asp-action="Index"
                   asp-all-route-data="@routeData"
                   asp-route-pageNumber="@(Model.PageIndex - 1)">
                Trước
            </a>
        </li>

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a class="page-link"
                       asp-action="Index"
                       asp-all-route-data="@routeData"
                       asp-route-pageNumber="@i">
                    @i
                </a>
            </li>
        }

        <li class="page-item @nextDisabled">
            <a class="page-link"
                   asp-action="Index"
                   asp-all-route-data="@routeData"
                   asp-route-pageNumber="@(Model.PageIndex + 1)">
                Sau
            </a>
        </li>
    </ul>
</div>

@section Scripts {
    <script>
        async function addToCart(id) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            const formData = new FormData();
            formData.append("motorcycleId", id);
            formData.append("quantity", 1);
            if (token) formData.append("__RequestVerificationToken", token);

            const res = await fetch('/Cart/AddMotorcycle', {
                method: 'POST',
                body: formData
            });

            const data = await res.json();

            if (data.success) {
                const count = document.getElementById('cart-count');
                if (count) count.innerText = data.count;

                alert("✅ Đã thêm vào giỏ!");
            } else {
                alert("❌ Lỗi thêm giỏ hàng");
            }
        }

        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.add-to-cart-btn');
            if (!btn) return;

            const id = btn.getAttribute('data-id');
            addToCart(id);
        });
    </script>
}